# ── Rédaction IA ───────────────────────────────────────────────────────────
# Sans cette clé, les brouillons sont dérivés localement de la source
# (l'application reste utilisable, mais sans rédaction par le modèle).
ANTHROPIC_API_KEY=

# ── Publication X ──────────────────────────────────────────────────────────
# Sans ces identifiants, la connexion bascule sur un compte de démonstration
# et les publications sont simulées puis enregistrées, sans être diffusées.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# URL publique de l'application, utilisée pour construire les redirections.
APP_URL=http://localhost:3000

# ── Divers ─────────────────────────────────────────────────────────────────
# Emplacement de la base SQLite.
CLIEDD_DB_PATH=.data/cliedd.db

# Si défini, /api/cron/tick exige l'en-tête « Authorization: Bearer <valeur> ».
CRON_SECRET=
